---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { reader, getPosts } from '../../lib/content';

const [site, posts] = await Promise.all([
  reader.singletons.site.readOrThrow(),
  getPosts(),
]);
---

<Layout title="文章动态" site={site}>
  <div class="site-container page-space">
    <h1>文章动态</h1>
    {posts.length > 0 ? (
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {posts.map(post => <li class="min-w-0"><PostCard post={post} headingLevel="h2" /></li>)}
      </ul>
    ) : <p class="mt-10 text-muted-foreground">暂无文章</p>}
  </div>
</Layout>
