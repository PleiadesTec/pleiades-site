---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getServices, reader } from '../../lib/content';

const site = await reader.singletons.site.readOrThrow();
const services = await getServices();
---

<Layout title="业务与服务" site={site}>
  <div class="site-container page-space">
    <h1>业务与服务</h1>
    {services.length > 0 ? (
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:gap-8">
        {services.map(service => <li class="min-w-0"><ServiceCard service={service} headingLevel="h2" /></li>)}
      </ul>
    ) : <p class="mt-10 text-muted-foreground">暂无业务内容</p>}
  </div>
</Layout>
