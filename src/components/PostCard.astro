---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headingLevel: 'h2' | 'h3';
}

const { post, headingLevel: Heading } = Astro.props;
const date = post.data.publishedAt?.toISOString().slice(0, 10);
---

<article class="content-card flex flex-col gap-3">
  {post.data.cover && (
    <img src={post.data.cover} alt={post.data.title} width="960" height="600" loading="lazy" class="mb-3 aspect-[16/10] w-full rounded-2xl object-cover" />
  )}
  <Heading class="card-title">
    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
  </Heading>
  {post.data.excerpt && <p class="text-muted-foreground">{post.data.excerpt}</p>}
  {date && <time datetime={date} class="text-sm text-muted-foreground">{date}</time>}
</article>
