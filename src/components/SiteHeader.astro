---
import type { SiteSettings } from '../lib/content';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
---

<header>
  <a href="/">
    {site.logo ? <img src={site.logo} alt={site.companyName} /> : site.companyName}
  </a>
  <nav aria-label="主导航">
    <ul>
      {site.navigation.map(item => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>
